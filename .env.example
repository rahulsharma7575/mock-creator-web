# Copy this file to `.env` (next to docker-compose.yml on your Docker host) and fill in your real values.
# These keys give access to paid services (OpenRouter LLM/TTS + Magnific images) - protect this file (chmod 600).

# OpenRouter API key (LLM authoring + Fish Audio TTS)
OPENROUTER_API_KEY=sk-or-xxxx

# Magnific API key (TOPIK z-image generation, ~5 credits per image)
MAGNIFIC_API_KEY=MSxxxx

# PocketBase superuser used by the worker to manage jobs (created on first boot)
PB_SUPERUSER_EMAIL=admin@example.com
PB_PASSWORD=change-me-please

# Upstage Document Parse key (cloud OCR for scanned PDFs — book/paper modes)
# Get it from https://console.upstage.ai — leave empty to use local PyMuPDF + vision OCR fallback
UPSTAGE_API_KEY=up_xxxx

# Fal.ai key (image generation + PDF image upscaling)
FAL_KEY=fal_xxxx

# Google Gemini API key (primary author, direct Google API)
GEMINI_API_KEY=AIzaSyxxxx

# Host port mapped to the container's PocketBase port 8090 (any free port on the host)
HOST_PORT=8090

# Copy this file to `.env` (next to docker-compose.yml on your Docker host) and fill in your real values.
# These keys give access to paid services (OpenRouter LLM/TTS + Magnific images) — protect this file (chmod 600).

# OpenRouter API key (LLM authoring + Fish Audio TTS)
OPENROUTER_API_KEY=sk-or-xxxx

# Magnific API key (TOPIK z-image generation, ~5 credits per image)
MAGNIFIC_API_KEY=MSxxxx

# Web GUI + API login
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-please

# Host port mapped to the container port 33445 (any free port on the host)
HOST_PORT=33445
